#!/usr/bin/env bash
# Stamps the review: writes HEAD's hash to .claude/.review-passed.
# Run it as the last step of your review, after its final pass found nothing
# that must be fixed. It refuses on a dirty tree: a review of uncommitted
# changes is a review of no commit.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
if [ -n "$(git status --porcelain)" ]; then
  echo "mark-reviewed: the tree has uncommitted changes; commit them and review that commit." >&2
  exit 1
fi
mkdir -p .claude
git rev-parse HEAD >.claude/.review-passed
echo "reviewed: $(cat .claude/.review-passed)"
